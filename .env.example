# ========================================================
# FlyRank Capstone Platform Environment Configuration
# ========================================================

# Server Port & Mode
NODE_ENV=development
PORT=4000
TEST_SITE_PORT=5500
BASE_URL=http://localhost:4000

# PostgreSQL Connection
# For local Docker Compose, use: postgresql://postgres:postgres@localhost:5432/flyrank_widget_platform
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flyrank_widget_platform
DATABASE_SSL=false
# Optional isolated test database URL (if omitted, automated tests use in-memory PostgreSQL emulator)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flyrank_widget_platform_test
# Optional development flag to allow in-memory PostgreSQL fallback when daemon is offline
ALLOW_IN_MEMORY_FALLBACK=true

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars
JWT_EXPIRES_IN=24h

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:4000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_SUBMISSIONS=30
RATE_LIMIT_MAX_AUTH=15

# Geolocation Enrichment Providers
GEO_PROVIDER_A_URL=http://ip-api.com/json
GEO_PROVIDER_B_URL=https://ipapi.co
GEO_TIMEOUT_MS=2500
# Simulation flags for deterministic failure testing
GEO_PROVIDER_A_SIMULATE_FAIL=false
GEO_PROVIDER_B_SIMULATE_FAIL=false

# Background Notification Job Worker
NOTIFICATION_MODE=console
JOB_POLL_INTERVAL_MS=2000
JOB_MAX_ATTEMPTS=3
NOTIFICATION_SIMULATE_FAIL=false

# Idempotency Cache TTL
IDEMPOTENCY_TTL_SECONDS=86400
